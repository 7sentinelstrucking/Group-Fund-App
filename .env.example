# Group Fund App — environment variables

# Port the server listens on (default 3000)
PORT=3000

# Secret used to sign session cookies. Set a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Path to the SQLite database file (default ./data/fund.db).
# Only used for local dev — when DATABASE_URL is set, Postgres is used instead.
DB_PATH=./data/fund.db

# Postgres connection string (production). When set, the app uses Postgres
# instead of SQLite for EVERYTHING (fund data, users, payments, avatars,
# sessions). Get this from your Neon dashboard (it ends with ?sslmode=require).
# Neon requires SSL: leave PGSSLMODE unset (default) unless your provider
# does not use SSL, in which case set PGSSLMODE=disable.
DATABASE_URL=
#PGSSLMODE=disable

# PayPal mode: sandbox or live
PAYPAL_MODE=sandbox

# PayPal REST API credentials (from developer.paypal.com).
# NOTE: credentials entered by the admin in the app setup screen take precedence;
# these env vars are only a fallback. When BOTH sources are empty (or DEMO_MODE=true),
# the app runs in demo mode: payments are recorded without charging any real money.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# PayPal webhook ID (for verifying incoming webhook signatures).
# Webhooks are rejected (401) when this is missing — fail closed.
PAYPAL_WEBHOOK_ID=

# SMTP settings for admin email notifications (optional).
# If SMTP_HOST is unset, notifications are only logged + stored in the DB.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Set to "true" to force demo mode even when PayPal credentials are configured.
DEMO_MODE=
